VITE_DEBUG_MODE="true"
# API Configuration
#
# VITE_API_BASE_URL: always "/api" (same-origin). This value is compiled
# straight into the browser bundle, so it must NEVER be the real backend URL.
#
# BACKEND_ORIGIN: the real backend address (scheme://host:port, WITHOUT a
# trailing "/api"). It is server-only and is read by vite.config.ts (dev
# proxy) and by nginx at container runtime (production, see
# nginx.conf.template / Dockerfile) — it never reaches the client.
#
# Leave BACKEND_ORIGIN without "/api": both the Vite dev proxy and nginx's
# proxy_pass already preserve/append that prefix themselves, so adding it
# here would duplicate it (/api/api/...).
VITE_API_BASE_URL="/api"
BACKEND_ORIGIN="http://localhost:5149"

# Domain Configuration
VITE_REDIRECTION_DOMAIN="localhost:5149"

# Application Configuration
VITE_APP_NAME="URL Shortener"
VITE_APP_VERSION="1.0.0"